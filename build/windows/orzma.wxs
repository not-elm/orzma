<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="orzma"
           Manufacturer="notelm"
           Version="$(Version)"
           UpgradeCode="56EF2BDF-DC37-4133-BF9A-1AC7D22D1538"
           Scope="perUserOrMachine"
           Compressed="yes">

    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of orzma is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Scope="perUserOrMachine" emits ALLUSERS=2 and MSIINSTALLPERUSER=1 itself, so
         per-user is the default context and ProgramFiles6432Folder resolves to
         %LocalAppData%\Programs at run time. Writing either Property by hand fails the
         build with WIX0091 (duplicate symbol). -->
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/not-elm/orzma" />
    <Property Id="ARPPRODUCTICON" Value="orzma.ico" />
    <Icon Id="orzma.ico" SourceFile="!(bindpath.build)\orzma.ico" />
    <WixVariable Id="WixUILicenseRtf" Value="!(bindpath.stage)\license.rtf" />
    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="orzma" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="orzma" />
    </StandardDirectory>

    <Feature Id="Main" Title="orzma" Level="1">
      <Files Include="!(bindpath.stage)\**" Directory="INSTALLFOLDER" />

      <Component Directory="INSTALLFOLDER" Id="CmpPath">
        <RegistryValue Root="HKMU" Key="Software\orzma" Name="PathAdded"
                       Type="integer" Value="1" KeyPath="yes" />
        <Environment Id="UpdatePath" Name="PATH" Value="[INSTALLFOLDER]"
                     Part="last" Action="set" System="no" Permanent="no" />
      </Component>

      <!-- HKCU, not HKMU: a shortcut under ProgramMenuFolder is per-user data, and
           ICE57 rejects a component that pairs it with a scope-dependent keypath. -->
      <Component Directory="ShortcutFolder" Id="CmpShortcut">
        <RegistryValue Root="HKCU" Key="Software\orzma" Name="ShortcutInstalled"
                       Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="OrzmaShortcut" Name="orzma"
                  Target="[INSTALLFOLDER]orzma.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="orzma.ico" />
        <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
      </Component>

      <!-- CEF writes debug.log next to the executable when log_file is unset.
           An unmanaged file left behind blocks removal of the install folder. -->
      <Component Directory="INSTALLFOLDER" Id="CmpCefLog">
        <RegistryValue Root="HKMU" Key="Software\orzma" Name="LogCleanup"
                       Type="integer" Value="1" KeyPath="yes" />
        <RemoveFile Id="RemoveCefDebugLog" Name="debug.log" On="uninstall" />
      </Component>
    </Feature>
  </Package>
</Wix>
